          frustum: '원뿔대를 회전축을 포함하는 평면으로 자른 단면은 항상 좌우 대칭인 <strong>사다리꼴(등변사다리꼴)</strong>입니다.',
          sphere: '구를 회전축(구에서는 중심을 지나는 직선)을 포함하는 평면으로 자른 단면은 가장 큰 <strong>원</strong>입니다.',
          hollowCylinder: '회전축에서 떨어진 직사각형을 돌려 만든 회전체를 회전축을 포함하는 평면으로 자르면 서로 합동인 <strong>두 개의 직사각형</strong>이 나타납니다.',
          custom: ''
        };
        titleEl.textContent = '회전축을 포함하는 평면으로 자를 때의 성질';
        const extra = axialDetails[preset] ? ` ${axialDetails[preset]}` : '';
        bodyEl.innerHTML = `회전체를 회전축을 포함하는 평면으로 자른 단면은 자르는 방향을 돌려도 <strong>모두 합동</strong>이며, 회전축을 대칭축으로 하는 <strong>선대칭도형</strong>입니다.${extra}`;
      } else if (state.cutMode === 'perpendicular') {
        titleEl.textContent = '회전축에 수직인 평면으로 자를 때의 성질';
        if (preset === 'hollowCylinder') {
          bodyEl.innerHTML = '회전축에 수직인 평면으로 회전체를 자르면 단면의 경계는 항상 <strong>원</strong>입니다. 가운데가 비어 있는 회전체이므로 크기가 다른 두 원 사이의 <strong>고리 모양</strong>이 나타납니다.';
        } else if (preset === 'cylinder') {
          bodyEl.innerHTML = '원기둥을 회전축에 수직인 평면으로 자른 단면은 자르는 높이에 관계없이 항상 밑면과 합동인 <strong>원</strong>입니다.';
        } else {
          bodyEl.innerHTML = '회전체를 회전축에 수직인 평면으로 자르면 그 단면은 항상 <strong>원</strong>(또는 가운데가 빈 고리 모양)입니다. 높이를 위아래로 바꾸며 원의 크기 변화를 관찰해 보세요!';
        }
      } else if (state.cutMode === 'oblique') {
        titleEl.textContent = '비스듬한 평면으로 자를 때의 단면 관찰';
        if (preset === 'sphere') {
          bodyEl.innerHTML = '<strong>구</strong>는 어느 방향으로 평면을 기울여 잘라도 그 단면이 항상 <strong>원</strong>입니다! 기울기와 높이를 바꿔 확인해 보세요.';
        } else {
          bodyEl.innerHTML = '회전체를 비스듬한 평면으로 자르면 길쭉하게 둥근 모양이나 밑면과 만나 일부가 곧은 선분으로 잘린 모양 등 다양한 단면을 관찰할 수 있습니다.';
        }
      }
    }

    // ==================== [이벤트 연결 및 상호작용 로직] ====================
    function applyNewShape(points, presetKey) {
      state.shapePoints = points;
      state.currentPreset = presetKey;
      state.draftPoints = [];
      state.hoverPoint = null;

      document.getElementById('currentShapeBadge').textContent = SHAPE_NAMES[presetKey] || '내가 그린 회전체';

      // 기본 도형 버튼 강조 표시 갱신
      document.querySelectorAll('.shape-btn').forEach(btn => {
        const isSelected = btn.dataset.shape === presetKey;
        btn.classList.toggle('border-2', isSelected);
        btn.classList.toggle('border-indigo-600', isSelected);
        btn.classList.toggle('bg-indigo-50', isSelected);
        btn.classList.toggle('text-indigo-700', isSelected);
        btn.classList.toggle('font-bold', isSelected);

        btn.classList.toggle('border', !isSelected);
        btn.classList.toggle('border-slate-200', !isSelected);
        btn.classList.toggle('bg-slate-50', !isSelected);
        btn.classList.toggle('text-slate-700', !isSelected);
      });

      updatePolygonToolButtons();
      rebuildInsideMask();
      renderDrawCanvas();
      rebuild3DScene();
    }

    function updatePolygonToolButtons() {
      const cnt = state.draftPoints.length;
      const btnClosePoly = document.getElementById('btnClosePoly');
      const btnCloseToAxis = document.getElementById('btnCloseToAxis');
      const countEl = document.getElementById('polyPointCount');

      if (cnt === 0) {
        countEl.textContent = '모눈 위를 눌러 꼭짓점을 찍으세요';
      } else {
        countEl.textContent = `찍은 꼭짓점: ${cnt}개`;
      }

      const canClosePoly = cnt >= 3;
      const canCloseAxis = cnt >= 2;

      btnClosePoly.disabled = !canClosePoly;
      btnClosePoly.className = canClosePoly
        ? 'py-1.5 px-2 rounded-lg text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition'
        : 'py-1.5 px-2 rounded-lg text-xs font-semibold bg-slate-100 text-slate-400 disabled:cursor-not-allowed transition';

      btnCloseToAxis.disabled = !canCloseAxis;
      btnCloseToAxis.className = canCloseAxis
        ? 'py-1.5 px-2 rounded-lg text-xs font-bold bg-indigo-100 hover:bg-indigo-200 text-indigo-800 transition'
        : 'py-1.5 px-2 rounded-lg text-xs font-semibold bg-slate-100 text-slate-400 disabled:cursor-not-allowed transition';
    }

    // 자유 곡선 점 간소화 (너무 촘촘한 점 정리)
    function simplifyFreehandPoints(pts, minDist = 0.14) {
      if (pts.length <= 2) return pts.slice();
      const result = [pts[0]];
      for (let i = 1; i < pts.length - 1; i++) {
        const prev = result[result.length - 1];
        const dist = Math.hypot(pts[i].r - prev.r, pts[i].y - prev.y);
        if (dist >= minDist) {
          result.push(pts[i]);
        }
      }
      result.push(pts[pts.length - 1]);
      return result;
    }

    function setupEvents() {
      // 1. 기본 도형 버튼
      document.querySelectorAll('.shape-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.shape;
          applyNewShape(getBasicShapePoints(key), key);
        });
      });

      // 2. 그리기 탭 전환
      const tabPolygon = document.getElementById('tabPolygon');
      const tabFreehand = document.getElementById('tabFreehand');
      const polygonTools = document.getElementById('polygonTools');
      const freehandTools = document.getElementById('freehandTools');
      const drawGuideText = document.getElementById('drawGuideText');

      tabPolygon.addEventListener('click', () => {
        state.drawMode = 'polygon';
        state.draftPoints = [];
        tabPolygon.className = 'py-1.5 px-2 rounded-lg text-xs font-bold bg-white text-indigo-700 shadow-sm transition';
        tabFreehand.className = 'py-1.5 px-2 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-800 transition';
        polygonTools.classList.remove('hidden');
        freehandTools.classList.add('hidden');
        drawGuideText.textContent = '회전축 오른쪽 모눈에 점을 찍어 다각형을 그려 보세요.';
        updatePolygonToolButtons();
        renderDrawCanvas();
      });

      tabFreehand.addEventListener('click', () => {
        state.drawMode = 'freehand';
        state.draftPoints = [];
        tabFreehand.className = 'py-1.5 px-2 rounded-lg text-xs font-bold bg-white text-indigo-700 shadow-sm transition';
        tabPolygon.className = 'py-1.5 px-2 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-800 transition';
        freehandTools.classList.remove('hidden');
        polygonTools.classList.add('hidden');
        drawGuideText.textContent = '모눈 위를 끌어서 원하는 옆선(모선) 모양을 자유롭게 그려 보세요.';
        renderDrawCanvas();
      });

      document.getElementById('chkSnapGrid').addEventListener('change', (e) => {
        state.snapToGrid = e.target.checked;
      });

      document.getElementById('chkAutoFillAxis').addEventListener('change', (e) => {
        state.autoFillAxis = e.target.checked;
      });

      // 새로 그리기 버튼
      document.getElementById('btnClearDraw').addEventListener('click', () => {
        state.draftPoints = [];
        state.shapePoints = [];
        state.currentPreset = 'custom';
        document.getElementById('currentShapeBadge').textContent = '새 도형 그리기 중';
        document.querySelectorAll('.shape-btn').forEach(b => {
          b.classList.remove('border-2', 'border-indigo-600', 'bg-indigo-50', 'text-indigo-700', 'font-bold');
          b.classList.add('border', 'border-slate-200', 'bg-slate-50', 'text-slate-700');
        });
        updatePolygonToolButtons();
        rebuildInsideMask();
        renderDrawCanvas();
        rebuild3DScene();
        showToast('모눈 위에서 새로운 평면도형을 그려 보세요!');
      });

      // 다각형 닫기 버튼
      document.getElementById('btnClosePoly').addEventListener('click', () => {
        if (state.draftPoints.length >= 3) {
          applyNewShape(state.draftPoints.slice(), 'custom');
          showToast('다각형이 완성되어 회전체를 만들었습니다!');
        }
      });

      // 회전축에 붙여 완성 버튼 (시작점과 끝점에서 회전축에 수직으로 선분을 내려 완성)
      document.getElementById('btnCloseToAxis').addEventListener('click', () => {
        if (state.draftPoints.length >= 2) {
          const pts = state.draftPoints.slice();
          const first = pts[0];
          const last = pts[pts.length - 1];
          if (last.r > 0.01) pts.push({ r: 0, y: last.y });
          if (first.r > 0.01) pts.push({ r: 0, y: first.y });
          applyNewShape(pts, 'custom');
          showToast('회전축에 수직으로 이어 평면도형을 완성했습니다!');
        }
      });

      // 3. 2D 캔버스 마우스/터치 통합(Pointer Events) 그리기
      drawCanvas.addEventListener('pointerdown', (e) => {
        const rect = drawCanvas.getBoundingClientRect();
        const cx = e.clientX - rect.left;
        const cy = e.clientY - rect.top;
        const layout = getDrawLayout();

        if (state.drawMode === 'polygon') {
          const pt = canvas2DToModel(cx, cy, layout, state.snapToGrid);

          // 첫 번째 점 근처를 다시 누르면 자동으로 도형 닫기
          if (state.draftPoints.length >= 3) {
            const firstCanvas = modelToCanvas2D(state.draftPoints[0].r, state.draftPoints[0].y, layout);
            const distPx = Math.hypot(cx - firstCanvas.cx, cy - firstCanvas.cy);
            if (distPx < 16) {
              applyNewShape(state.draftPoints.slice(), 'custom');
              showToast('꼭짓점을 이어 평면도형을 완성했습니다!');
              return;
            }
          }

          state.draftPoints.push(pt);
          updatePolygonToolButtons();
          renderDrawCanvas();
        } else {
          // 자유롭게 그리기 시작
          drawCanvas.setPointerCapture(e.pointerId);
          state.isDraggingFreehand = true;
          const pt = canvas2DToModel(cx, cy, layout, false);
          state.draftPoints = [pt];
          renderDrawCanvas();
        }
      });

      drawCanvas.addEventListener('pointermove', (e) => {
        const rect = drawCanvas.getBoundingClientRect();
        const cx = e.clientX - rect.left;
        const cy = e.clientY - rect.top;
        const layout = getDrawLayout();

        if (state.drawMode === 'polygon') {
          state.hoverPoint = canvas2DToModel(cx, cy, layout, state.snapToGrid);
          renderDrawCanvas();
        } else if (state.isDraggingFreehand) {
          const pt = canvas2DToModel(cx, cy, layout, false);
          state.draftPoints.push(pt);
          renderDrawCanvas();
        }
      });

      drawCanvas.addEventListener('pointerleave', () => {
        if (state.drawMode === 'polygon') {
          state.hoverPoint = null;
          renderDrawCanvas();
        }
      });

      const finishFreehand = () => {
        if (!state.isDraggingFreehand) return;
        state.isDraggingFreehand = false;

        let simplified = simplifyFreehandPoints(state.draftPoints, 0.14);
        if (simplified.length < 2) {
          state.draftPoints = [];
          renderDrawCanvas();
          return;
        }

        if (state.autoFillAxis) {
          const first = simplified[0];
          const last = simplified[simplified.length - 1];
          // 위아래 높이가 너무 같으면 안내
          if (Math.abs(first.y - last.y) < 0.25 && simplified.length < 4) {
            state.draftPoints = [];
            renderDrawCanvas();
            showToast('위아래로 조금 더 길게 옆선을 그려 보세요!');
            return;
          }
          if (last.r > 0.01) simplified.push({ r: 0, y: last.y });
          if (first.r > 0.01) simplified.push({ r: 0, y: first.y });
        } else if (simplified.length < 3) {
          state.draftPoints = [];
          renderDrawCanvas();
          showToast('조금 더 크게 도형을 그려 주세요!');
          return;
        }

        applyNewShape(simplified, 'custom');
        showToast('내가 그린 모양으로 회전체를 만들었습니다!');
      };

      drawCanvas.addEventListener('pointerup', finishFreehand);
      drawCanvas.addEventListener('pointercancel', finishFreehand);

      // 4. 중앙 3D 회전 각도 슬라이더 및 한 바퀴 돌리기 애니메이션
      const sliderSweep = document.getElementById('sliderSweep');
      const lblSweepAngle = document.getElementById('lblSweepAngle');
      const btnPlaySweep = document.getElementById('btnPlaySweep');

      sliderSweep.addEventListener('input', (e) => {
        state.isPlayingSweep = false;
        updatePlayButtonUI();
        state.sweepDeg = Number(e.target.value);
        lblSweepAngle.textContent = `${Math.round(state.sweepDeg)}°`;
        rebuild3DScene();
      });

      btnPlaySweep.addEventListener('click', () => {
        if (state.isPlayingSweep) {
          state.isPlayingSweep = false;
        } else {
          if (state.sweepDeg >= 359) {
            state.sweepDeg = 0;
          }
          state.isPlayingSweep = true;
        }
        updatePlayButtonUI();
      });

      // 반투명 보기 & 모선 표시 토글
      document.getElementById('btnToggleTransparent').addEventListener('click', (e) => {
        state.isTransparent = !state.isTransparent;
        const btn = e.currentTarget;
        const dot = document.getElementById('dotTransparent');
        btn.classList.toggle('bg-indigo-50', state.isTransparent);
        btn.classList.toggle('border-indigo-400', state.isTransparent);
        btn.classList.toggle('text-indigo-700', state.isTransparent);
        dot.className = state.isTransparent ? 'w-2 h-2 rounded-full bg-indigo-600' : 'w-2 h-2 rounded-full bg-slate-400';
        rebuild3DScene();
      });

      document.getElementById('btnToggleGeneratrix').addEventListener('click', (e) => {
        state.showGeneratrix = !state.showGeneratrix;
        const btn = e.currentTarget;
        const dot = document.getElementById('dotGeneratrix');
        btn.classList.toggle('bg-indigo-50', state.showGeneratrix);
        btn.classList.toggle('border-indigo-400', state.showGeneratrix);
        btn.classList.toggle('text-indigo-700', state.showGeneratrix);
        dot.className = state.showGeneratrix ? 'w-2 h-2 rounded-full bg-indigo-600' : 'w-2 h-2 rounded-full bg-slate-400';
        rebuild3DScene();
      });

      // 시점 빠른 이동 버튼
      document.querySelectorAll('.cam-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.cam-btn').forEach(b => {
            b.className = 'cam-btn px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 text-xs font-semibold text-slate-600 transition';
          });
          btn.className = 'cam-btn px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-xs font-semibold transition';

          const mode = btn.dataset.cam;
          controls.target.set(0, 0, 0);
          if (mode === 'front') {
            camera.position.set(0, 0.4, 13.5);
          } else if (mode === 'top') {
            camera.position.set(0, 14.0, 0.01);
          } else {
            camera.position.set(7.5, 5.8, 10.5);
          }
          controls.update();
        });
      });

      // 5. 우측 단면 자르기 컨트롤
      document.querySelectorAll('.cut-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.cutMode = btn.dataset.cut;

          document.querySelectorAll('.cut-btn').forEach(b => {
            const active = b.dataset.cut === state.cutMode;
            b.className = active
              ? 'cut-btn py-2 px-2.5 rounded-xl border-2 border-orange-500 bg-orange-50 text-orange-800 text-xs font-bold transition text-center'
              : 'cut-btn py-2 px-2.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-orange-50/40 text-slate-700 text-xs font-semibold transition text-center';
          });

          const panel = document.getElementById('cutControlPanel');
          const ctrlAxial = document.getElementById('ctrlAxialAngle');
          const ctrlHeight = document.getElementById('ctrlCutHeight');
          const ctrlTilt = document.getElementById('ctrlCutTilt');

          if (state.cutMode === 'none') {
            panel.classList.add('hidden');
            panel.classList.remove('flex');
          } else {
            panel.classList.remove('hidden');
            panel.classList.add('flex');

            ctrlAxial.className = state.cutMode === 'axial' ? 'flex flex-col gap-1' : 'hidden';
            ctrlHeight.className = (state.cutMode === 'perpendicular' || state.cutMode === 'oblique') ? 'flex flex-col gap-1' : 'hidden';
            ctrlTilt.className = state.cutMode === 'oblique' ? 'flex flex-col gap-1' : 'hidden';
          }

          rebuild3DScene();
        });
      });

      // 단면 조절 슬라이더들
      document.getElementById('sliderAxialAngle').addEventListener('input', (e) => {
        state.axialAngleDeg = Number(e.target.value);
        document.getElementById('lblAxialAngle').textContent = `${state.axialAngleDeg}°`;
        rebuild3DScene();
      });

      document.getElementById('sliderCutHeight').addEventListener('input', (e) => {
        state.cutHeight = Number(e.target.value);
        const h = state.cutHeight;
        const lbl = document.getElementById('lblCutHeight');
        if (Math.abs(h) < 0.15) lbl.textContent = '가운데';
        else if (h > 0) lbl.textContent = `위쪽 (+${h.toFixed(1)})`;
        else lbl.textContent = `아래쪽 (${h.toFixed(1)})`;
        rebuild3DScene();
      });

      document.getElementById('sliderCutTilt').addEventListener('input', (e) => {
        state.cutTiltDeg = Number(e.target.value);
        document.getElementById('lblCutTilt').textContent = `${state.cutTiltDeg}°`;
        rebuild3DScene();
      });

      document.getElementById('chkShowPlaneFrame').addEventListener('change', (e) => {
        state.showPlaneFrame = e.target.checked;
        rebuild3DScene();
      });

      document.getElementById('chkShowCutGhost').addEventListener('change', (e) => {
        state.showCutGhost = e.target.checked;
        rebuild3DScene();
      });

      // 처음 상태로 초기화 버튼
      document.getElementById('btnResetAll').addEventListener('click', () => {
        state.sweepDeg = 360;
        state.isPlayingSweep = false;
        updatePlayButtonUI();
        document.getElementById('sliderSweep').value = 360;
        document.getElementById('lblSweepAngle').textContent = '360°';

        state.cutMode = 'none';
        state.axialAngleDeg = 0;
        state.cutHeight = 0;
        state.cutTiltDeg = 30;
        document.getElementById('sliderAxialAngle').value = 0;
        document.getElementById('lblAxialAngle').textContent = '0°';
        document.getElementById('sliderCutHeight').value = 0;
        document.getElementById('lblCutHeight').textContent = '가운데';
        document.getElementById('sliderCutTilt').value = 30;
        document.getElementById('lblCutTilt').textContent = '30°';

        document.querySelector('[data-cut="none"]').click();
        camera.position.set(7.5, 5.8, 10.5);
        controls.target.set(0, 0, 0);
        controls.update();

        applyNewShape(getBasicShapePoints('cone'), 'cone');
        showToast('처음 상태로 되돌렸습니다.');
      });

      // 창 크기 변경 대응
      window.addEventListener('resize', handleResize);
    }

    function updatePlayButtonUI() {
      const txt = document.getElementById('txtPlaySweep');
      const icon = document.getElementById('iconPlay');
      if (state.isPlayingSweep) {
        txt.textContent = '멈추기';
        icon.innerHTML = '<path d="M5.75 3a.75.75 0 00-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 00.75-.75V3.75A.75.75 0 007.25 3h-1.5zM12.75 3a.75.75 0 00-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 00.75-.75V3.75a.75.75 0 00-.75-.75h-1.5z" />';
      } else {
        txt.textContent = '한 바퀴 돌리기';
        icon.innerHTML = '<path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z" />';
      }
    }

    function handleResize() {
      renderDrawCanvas();

      if (renderer && camera) {
        const w = threeContainer.clientWidth;
        const h = threeContainer.clientHeight;
        if (w > 0 && h > 0) {
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h);
        }
      }

      renderSection2DView(getCutPlaneInfo());
    }

    // ==================== [메인 애니메이션 루프] ====================
    let lastTime = performance.now();
    function animate(now) {
      requestAnimationFrame(animate);

      const dt = Math.min(0.05, (now - lastTime) / 1000);
      lastTime = now;

      if (state.isPlayingSweep) {
        state.sweepDeg += dt * 110; // 약 3.2초 동안 부드럽게 1회전
        if (state.sweepDeg >= 360) {
          state.sweepDeg = 360;
          state.isPlayingSweep = false;
          updatePlayButtonUI();
        }
        document.getElementById('sliderSweep').value = state.sweepDeg;
        document.getElementById('lblSweepAngle').textContent = `${Math.round(state.sweepDeg)}°`;
        rebuild3DScene();
      }

      if (controls) controls.update();
      if (renderer && scene && camera) renderer.render(scene, camera);
    }

    // ==================== [초기 실행] ====================
    window.onload = function () {
      initThreeJS();
      setupEvents();
      applyNewShape(getBasicShapePoints('cone'), 'cone');
      handleResize();
      lastTime = performance.now();
      animate(lastTime);
    };
  </script>
</body>
</html>
